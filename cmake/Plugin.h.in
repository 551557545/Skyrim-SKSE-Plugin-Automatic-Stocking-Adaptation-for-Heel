#pragma once

#include <SKSE/SKSE.h>


namespace Plugin
{
	inline constexpr auto NAME = "@PROJECT_NAME@"sv;
	inline constexpr auto AUTHOR = "@SKSEPluginAuthor@"sv;
	inline constexpr REL::Version Version
	{
		@PROJECT_VERSION_MAJOR@u,
		@PROJECT_VERSION_MINOR@u,
		@PROJECT_VERSION_PATCH@u
	};
}

// 新版本 CommonLibSSE-NG 官方推荐的插件声明方式（使用指定初始化器）。
// 同时生成 SKSEPlugin_Version（SKSE::PluginDeclaration）与 SKSEPlugin_Query，
// 保证 SKSE 在完成 Query 兼容性检查后才会调用 SKSEPlugin_Load 入口。
SKSEPluginInfo(
	.Version = Plugin::Version,
	.Name = Plugin::NAME,
	.Author = Plugin::AUTHOR,
	.SupportEmail = ""
)

